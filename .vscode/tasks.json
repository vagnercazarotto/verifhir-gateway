{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quality Check (Git Bash)",
      "type": "shell",
      "command": "C:/Program Files/Git/bin/bash.exe",
      "args": [
        "-lc",
        "cd '/c/gitworkspace/verifhir-gateway' && ./scripts/quality-check.sh"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Go Test ./...",
      "type": "shell",
      "command": "go",
      "args": [
        "test",
        "./...",
        "-count=1"
      ],
      "group": "test",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Run Gateway (Git Bash)",
      "type": "shell",
      "command": "C:/Program Files/Git/bin/bash.exe",
      "args": [
        "-lc",
        "cd '/c/gitworkspace/verifhir-gateway' && ./scripts/run-local.sh"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Generate Dataset (Git Bash)",
      "type": "shell",
      "command": "C:/Program Files/Git/bin/bash.exe",
      "args": [
        "-lc",
        "cd '/c/gitworkspace/verifhir-gateway' && ./scripts/generate-dataset.sh"
      ],
      "problemMatcher": []
    }
  ]
}
